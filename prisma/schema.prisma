generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())

  reference String

  composition String?

  unavailableSizes String[]

  name        String

  slug        String   @unique

  description String

  image       String

  image2      String?

  image3      String?

  image4      String?

  image5      String?

  price       Float

  wholesalePrice   Float?

  category    String

  collection  String

  isNew       Boolean

  featured    Boolean

  active      Boolean

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt
}